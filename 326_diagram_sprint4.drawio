l><mxCell id="n31" value="validation, search/sort, canChange for the list&lt;br&gt;new profile: ownerId = logged-in user" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#e8dca0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="345.9" y="749" width="318.2" height="32" as="geometry"/></mxCell><mxCell id="n32" value="&lt;b style=&quot;font-size:14px;color:#ffffff&quot;&gt;services/authService.js&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#d8d8d8&quot;&gt;validates email + password (8+ chars)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#d8d8d8&quot;&gt;bcrypt.hash on signup, bcrypt.compare on login&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#d8d8d8&quot;&gt;role always set to 'member' (body ignored)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#d8d8d8&quot;&gt;returns toUserDto (dtos/userDto.js):&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#d8d8d8&quot;&gt;{ id, email, role }, never the hash&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#33290f;strokeColor=#c49a2c;strokeWidth=1.6;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="650" width="350" height="135" as="geometry"/></mxCell><mxCell id="n33" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#ffffff;strokeWidth=1.6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490.0" y="592" as="sourcePoint"/><mxPoint x="490.0" y="648" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n34" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#ffffff;strokeWidth=1.6;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520.0" y="650" as="sourcePoint"/><mxPoint x="520.0" y="594" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n35" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#ffffff;strokeWidth=1.6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880.0" y="592" as="sourcePoint"/><mxPoint x="880.0" y="648" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n36" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#ffffff;strokeWidth=1.6;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910.0" y="650" as="sourcePoint"/><mxPoint x="910.0" y="594" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n37" value="Ok(value) / Err({status, message})" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#cfcfcf;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="530.0" y="619" width="232.39999999999998" height="18" as="geometry"/></mxCell><mxCell id="n38" value="Ok / Err" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#cfcfcf;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="920.0" y="619" width="60.8" height="18" as="geometry"/></mxCell><mxCell id="n39" value='&lt;b style="font-size:14px;color:#ffffff"&gt;repositories/profilesRepository.js&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#d8d8d8"&gt;getAll, findById, create, removeById&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#3a2a14;strokeColor=#c98a3a;strokeWidth=1.6;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="840" width="350" height="70" as="geometry"/></mxCell><mxCell id="n40" value='&lt;b style="font-size:14px;color:#ffffff"&gt;repositories/usersRepository.js&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#d8d8d8"&gt;findByEmail, findById, create, updateRole&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#3a2a14;strokeColor=#c98a3a;strokeWidth=1.6;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="840" width="350" height="70" as="geometry"/></mxCell><mxCell id="n41" style="edgeStyle=none;html=1;endArrow=block;endF