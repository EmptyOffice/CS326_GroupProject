h.test.js: /health 200 JSON&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#2a2233;strokeColor=#9a7fc7;strokeWidth=1.6;fontFamily=Helvetica;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="1110" y="968" width="260" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>