<mxfile host="app.diagrams.net"><diagram id="s4" name="Sprint 4 System Diagram"><mxGraphModel dx="1400" dy="1330" grid="0" gridSize="10" guides="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1260" background="#141414" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value='&lt;b style="font-size:15px;color:#ffffff"&gt;Browser&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#d8d8d8"&gt;views: index, profiles, login, signup, partials/nav, partials/profile-list  •  HTMX + public/app.js, public/auth.js&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1d2a44;strokeColor=#5b7fc7;strokeWidth=1.6;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="20" width="740" height="64" as="geometry"/></mxCell><mxCell id="n3" value='&lt;b style="font-size:14px;color:#ffffff"&gt;server.js  (Express app, middleware runs top to bottom)&lt;/b&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#262626;strokeColor=#9a9a9a;strokeWidth=1.6;fontFamily=Helvetica;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="330" y="140" width="740" height="150" as="geometry"/></mxCell><mxCell id="n4" value='&lt;b style="font-size:13px;color:#ffffff"&gt;1. /health&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#d8d8d8"&gt;mounted first,&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#d8d8d8"&gt;before the session&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1f3a3a;strokeColor=#4fb0a8;strokeWidth=1.6;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="340.0" y="180" width="172.5" height="96" as="geometry"/></mxCell><mxCell id="n5" value='&lt;b style="font-size:13px;color:#ffffff"&gt;2. static, json,&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#d8d8d8"&gt;urlencoded&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#2b2b2b;strokeColor=#9a9a9a;strokeWidth=1.6;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="522.5" y="180" width="172.5" height="96" as="geometry"/></mxCell><mxCell id="n6" value='&lt;b style="font-size:13px;color:#ffffff"&gt;3. Session&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#d8d8d8"&gt;express-session, signed&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#d8d8d8"&gt;cookie (SESSION_SECRET)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#d8d8d8"&gt;httpOnly, sameSite=lax&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#d8d8d8"&gt;store: connect-mongo&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#3a2342;strokeColor=#b07fd0;strokeWidth=1.6;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="705.0" y="180" width="172.5" height="96" as="geometry"/></mxCell><mxCell id="n7" value='&lt;b style="font-size:13px;color:#ffffff"&gt;4. res.locals.user&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#d8d8d8"&gt;= req.session.user&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#d8d8d8"&gt;page routes: / /profiles&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#d8d8d8"&gt;/login /signup (render EJS)&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#2b2b2b;strokeColor=#9a9a9a;strokeWidth=1.6;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="887.5" y="180" width="172.5" height="96" as="geometry"/></mxCell><mxCell id="n8" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#ffffff;strokeWidth=1.6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="505.0" y="84" as="sourcePoint"/><mxPoint x="505.0" y="138" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n9" value="HTTP requests + session cookie" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#cfcfcf;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="513.0" y="101" width="206.0" height="18" as="geometry"/></mxCell><mxCell id="n10" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#ffffff;strokeWidth=1.6;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="895.0" y="140" as="sourcePoint"/><mxPoint x="895.0" y="86" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n11" value="HTML / JSON responses" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#cfcfcf;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="903.0" y="101" width="146.6" height="18" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b style=&quot;font-size:14px;color:#ffffff&quot;&gt;routes/health.js&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#d8d8d8&quot;&gt;GET /health&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#d8d8d8&quot;&gt;200 {status:'ok', uptime, ...}&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#d8d8d8&quot;&gt;no login, no session, no DB&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1f3a3a;strokeColor=#4fb0a8;strokeWidth=1.6;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="160" width="250" height="110" as="geometry"/></mxCell><mxCell id="n13" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#7fd0c8;strokeWidth=1.6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340.0" y="228.0" as="sourcePoint"/><mxPoint x="282" y="228.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n14" value='&lt;b style="font-size:14px;color:#ffffff"&gt;routes/profiles.js&lt;/b&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1f3524;strokeColor=#4f9a5c;strokeWidth=1.6;fontFamily=Helvetica;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="330" y="350" width="350" height="124" as="geometry"/></mxCell><mxCell id="n15" value='&lt;b style="font-size:12px;color:#f3dc9a"&gt;requireLogin  (middleware/requireLogin.js)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#d8d8d8"&gt;on POST / and DELETE /:id&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#d8d8d8"&gt;no session user → 401, nothing changes&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#d8d8d8"&gt;GET / and /search are public&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#3a3214;strokeColor=#d0a83a;strokeWidth=1.6;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="342" y="382" width="326" height="80" as="geometry"/></mxCell><mxCell id="n16" value='&lt;b style="font-size:14px;color:#ffffff"&gt;routes/auth.js&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#d8d8d8"&gt;POST /auth/signup, /auth/login, /auth/logout&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#d8d8d8"&gt;GET /auth/me&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1f3524;strokeColor=#4f9a5c;strokeWidth=1.6;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="350" width="350" height="124" as="geometry"/></mxCell><mxCell id="n17" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#ffffff;strokeWidth=1.6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="505.0" y="290" as="sourcePoint"/><mxPoint x="505.0" y="348" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n18" value="app.use('/api/profiles')" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#cfcfcf;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="513.0" y="301" width="166.39999999999998" height="18" as="geometry"/></mxCell><mxCell id="n19" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#ffffff;strokeWidth=1.6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="895.0" y="290" as="sourcePoint"/><mxPoint x="895.0" y="348" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n20" value="app.use('/auth')" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#cfcfcf;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="903.0" y="301" width="113.6" height="18" as="geometry"/></mxCell><mxCell id="n21" value='&lt;b style="font-size:14px;color:#ffffff"&gt;controllers/profilesController.js&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#d8d8d8"&gt;passes req.session.user as the actor&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#d8d8d8"&gt;sends result.error.status (400/403/404)&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#203a2a;strokeColor=#5fb57a;strokeWidth=1.6;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="520" width="350" height="72" as="geometry"/></mxCell><mxCell id="n22" value='&lt;b style="font-size:14px;color:#ffffff"&gt;controllers/authController.js&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#d8d8d8"&gt;login/signup: session.regenerate, store user&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#d8d8d8"&gt;logout: session.destroy&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#203a2a;strokeColor=#5fb57a;strokeWidth=1.6;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="520" width="350" height="72" as="geometry"/></mxCell><mxCell id="n23" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#ffffff;strokeWidth=1.6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490.0" y="474" as="sourcePoint"/><mxPoint x="490.0" y="518" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n24" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#ffffff;strokeWidth=1.6;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520.0" y="520" as="sourcePoint"/><mxPoint x="520.0" y="476" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n25" style="edgeStyle=n