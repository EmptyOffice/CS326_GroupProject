<% if (profiles.length === 0) { %>
  <li class="p-4 bg-white rounded-lg shadow text-red-500 font-bold">No profiles found matching your search.</li>
<% } else { %>
  <% profiles.forEach(profile => { %>
    <li class="p-4 bg-white rounded-lg shadow border-l-4 border-blue-500 flex flex-col md:flex-row justify-between md:items-center">
      <div>
        <h3 class="text-xl font-bold text-gray-800"><%= profile.name %></h3>
        <p class="text-gray-600">Age: <%= profile.age %> | Years Played: <%= profile.yearsPlayed %></p>
        <p class="text-gray-500 text-sm mt-1">Availability: <%= profile.availability %></p>
      </div>
      <div class="mt-4 md:mt-0 flex flex-col md:items-end gap-2">
        <% if (profile.ustaRating) { %>
          <span class="inline-block bg-blue-100 text-blue-800 text-xs px-3 py-1 rounded-full font-bold">Rating: <%= profile.ustaRating %></span>
        <% } %>
        <% if (profile.ustaRanking) { %>
          <span class="inline-block bg-green-100 text-green-800 text-xs px-3 py-1 rounded-full font-bold">Rank: #<%= profile.ustaRanking %></span>
        <% } %>
      </div>
    </li>
  <% }) %>
<% } %>