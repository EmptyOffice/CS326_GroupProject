<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tennis Player Profiles</title>
  <link rel="stylesheet" href="/style.css">
  <script src="https://unpkg.com/htmx.org@1.9.10"></script>
  <script src="/app.js" defer></script>
</head>
<body class="bg-gray-50 text-gray-800 font-sans p-4 md:p-8">
  <header class="mb-8 text-center md:text-left">
    <h1 class="text-3xl font-extrabold text-blue-900">Tennis Player Profiles</h1>
  </header>

  <main class="max-w-4xl mx-auto space-y-8">
    <section class="bg-white p-6 rounded-lg shadow-md">
      <h2 class="text-2xl font-bold mb-4">Search Players</h2>
      <form hx-get="/api/profiles/search" hx-target="#profiles-list" hx-swap="innerHTML" class="flex flex-col md:flex-row gap-4">
        <input type="text" name="name" placeholder="Search by name..." class="flex-1 border border-gray-300 p-2 rounded">
        <input type="number" step="0.5" name="ustaRating" placeholder="Exact USTA Rating" class="flex-1 border border-gray-300 p-2 rounded">
        <input type="number" name="ustaRanking" placeholder="Max USTA Ranking" class="flex-1 border border-gray-300 p-2 rounded">
        <button type="submit" class="bg-blue-600 text-white font-bold py-2 px-4 rounded hover:bg-blue-700">Search</button>
        <button type="reset" class="bg-gray-300 text-gray-700 font-bold py-2 px-4 rounded hover:bg-gray-400">Clear</button>
      </form>
    </section>

    <section class="bg-white p-6 rounded-lg shadow-md">
      <h2 class="text-2xl font-bold mb-4">Create a Profile</h2>
      <form id="create-form" class="space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label for="name" class="block font-bold mb-1">Name</label>
            <input type="text" id="name" name="name" required class="w-full border border-gray-300 p-2 rounded">
          </div>

          <div>
            <label for="age" class="block font-bold mb-1">Age</label>
            <input type="number" id="age" name="age" required class="w-full border border-gray-300 p-2 rounded">
          </div>

          <div>
            <label for="yearsPlayed" class="block font-bold mb-1">Years Played</label>
            <input type="number" id="yearsPlayed" name="yearsPlayed" required class="w-full border border-gray-300 p-2 rounded">
          </div>

          <div>
            <label for="availability" class="block font-bold mb-1">Availability</label>
            <input type="text" id="availability" name="availability" placeholder="Weekends, Weekday Evenings" required class="w-full border border-gray-300 p-2 rounded">
          </div>

          <div>
            <label for="ustaRating" class="block font-bold mb-1">USTA Rating (optional)</label>
            <input type="number" step="0.5" id="ustaRating" name="ustaRating" class="w-full border border-gray-300 p-2 rounded">
          </div>

          <div>
            <label for="ustaRanking" class="block font-bold mb-1">USTA Ranking (optional)</label>
            <input type="number" id="ustaRanking" name="ustaRanking" class="w-full border border-gray-300 p-2 rounded">
          </div>
        </div>

        <button type="submit" class="w-full bg-green-600 text-white font-bold py-2 px-4 rounded hover:bg-green-700 mt-4">Create Profile</button>
      </form>
    </section>

    <div id="error" class="text-red-600 font-bold text-center"></div>

    <section>
      <h2 class="text-2xl font-bold mb-4">Players</h2>
      <ul id="profiles-list" class="space-y-4" hx-get="/api/profiles/search" hx-trigger="load"></ul>
    </section>
  </main>
</body>
</html>