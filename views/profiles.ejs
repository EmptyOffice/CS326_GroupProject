<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tennis Player Profiles</title>
  <link rel="stylesheet" href="/style.css">
  <script src="/app.js" defer></script>
</head>
<body>
  <header>
    <h1>Tennis Player Profiles</h1>
  </header>

  <main>
    <section class="card">
      <h2>Search Players</h2>
      <form id="search-form">
        <input type="text" name="name" placeholder="Search by name...">
        <input type="number" step="0.5" name="ustaRating" placeholder="Exact USTA Rating">
        <input type="number" name="ustaRanking" placeholder="Max USTA Ranking">
        <button type="submit">Search</button>
        <button type="reset">Clear</button>
      </form>
    </section>

    <section class="card">
      <h2>Create a Profile</h2>
      <form id="create-form">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" required>

        <label for="age">Age</label>
        <input type="number" id="age" name="age" required>

        <label for="yearsPlayed">Years Played</label>
        <input type="number" id="yearsPlayed" name="yearsPlayed" required>

        <label for="availability">Availability</label>
        <input type="text" id="availability" name="availability" placeholder="Weekends, Weekday Evenings" required>

        <label for="ustaRating">USTA Rating (optional)</label>
        <input type="number" step="0.5" id="ustaRating" name="ustaRating">

        <label for="ustaRanking">USTA Ranking (optional)</label>
        <input type="number" id="ustaRanking" name="ustaRanking">

        <button type="submit">Create Profile</button>
      </form>
    </section>
  </main>
</body>
</html>
